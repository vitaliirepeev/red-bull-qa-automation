BASE_URL=https://qa-sample-vitaliirepeev.up.railway.app
QA_EMAIL=qa.tester@example.com
QA_PASSWORD=replace-with-approved-qa-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-approved-admin-password
REQUEST_TIMEOUT_SECONDS=25

# Optional. Use a read-only database account.
DATABASE_URL=

# State-changing tests remain skipped unless all three values are supplied.
ALLOW_STATE_CHANGING_TESTS=false
QA_MUTABLE_DEVICE_ID=
QA_COMMAND_VERSION=6.4.10

# A guaranteed nonexistent value is safe for the contract example.
QA_UNKNOWN_DEVICE_ID=DOES-NOT-EXIST
